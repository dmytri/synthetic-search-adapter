[Unit]
Description=Synthetic Search adapter (Open WebUI external + SearXNG-compatible + passthrough)
Documentation=https://github.com/dmytri/synthetic-search-adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/synthetic-search-adapter/adapter.env
ExecStart=/usr/local/bin/synthetic-search-adapter
Restart=on-failure
RestartSec=5

# Sandboxing: the service needs no privileges and no writable state.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
